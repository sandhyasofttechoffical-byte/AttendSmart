<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blue_800"
        app:title="Movement Tracking"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back">

        <TextView
            android:id="@+id/tvEmployeeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Employee Name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_gravity="center" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Date and Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/blue_50"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="12 Jan 2024"
            android:textSize="14sp"
            android:textColor="@color/blue_800" />

        <ImageView
            android:id="@+id/ivGpsStatus"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:tint="@color/green" />

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: Good"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:textColor="@color/green" />

        <ImageView
            android:id="@+id/ivFakeGpsWarning"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/red"
            android:visibility="gone"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Fake GPS Warning Layout -->
    <LinearLayout
        android:id="@+id/fakeGpsWarningLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/red_100"
        android:padding="8dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/red" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="⚠️ Fake GPS detected! This may affect attendance validity."
            android:textColor="@color/red"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Map Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Map Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="vertical"
            android:layout_margin="16dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCenterMap"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/white"
                app:fabSize="mini"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnToggleLiveTracking"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/blue_500"
                app:fabSize="mini"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnRefresh"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/white"
                app:fabSize="mini" />

        </LinearLayout>

    </FrameLayout>

    <!-- Stats Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_margin="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movement Statistics"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/blue_800" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_300"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3">

                <!-- Check In -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check In:"
                    android:textColor="@color/gray_600"
                    android:textSize="13sp"
                    android:layout_column="0"
                    android:layout_row="0"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/tvCheckInTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 AM"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_column="1"
                    android:layout_row="0" />

                <!-- Check Out -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check Out:"
                    android:textColor="@color/gray_600"
                    android:textSize="13sp"
                    android:layout_column="0"
                    android:layout_row="1"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvCheckOutTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00 PM"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_column="1"
                    android:layout_row="1"
                    android:layout_marginTop="8dp" />

                <!-- Total Distance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Distance:"
                    android:textColor="@color/gray_600"
                    android:textSize="13sp"
                    android:layout_column="0"
                    android:layout_row="2"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvTotalDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.5 km"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_column="1"
                    android:layout_row="2"
                    android:layout_marginTop="8dp" />

            </GridLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_300"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvSnapshotCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_800" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Snapshots"
                        android:textSize="12sp"
                        android:textColor="@color/gray_600" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8h 30m"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_800" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tracking Time"
                        android:textSize="12sp"
                        android:textColor="@color/gray_600" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvAccuracyAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.5 m"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_800" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg Accuracy"
                        android:textSize="12sp"
                        android:textColor="@color/gray_600" />

                </LinearLayout>

            </LinearLayout>

            <!-- Live Location -->
            <TextView
                android:id="@+id/tvLiveLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live: 28.6139, 77.2090 (8.5m)"
                android:textSize="11sp"
                android:textColor="@color/gray_500"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>