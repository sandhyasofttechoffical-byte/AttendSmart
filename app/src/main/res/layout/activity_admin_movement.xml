<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blue_800"
        app:title="Employee Movement"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back">

        <Button
            android:id="@+id/btnExportData"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Export"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_gravity="end" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Selection Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/blue_50">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Employee:"
            android:textSize="12sp"
            android:textColor="@color/gray_600" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvSelectedEmployee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No employee selected"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_800" />

            <Button
                android:id="@+id/btnSelectEmployee"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Change"
                android:textSize="11sp"
                android:textColor="@color/blue_800" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_300"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date:"
                android:textSize="12sp"
                android:textColor="@color/gray_600" />

            <Spinner
                android:id="@+id/spinnerDateFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024-01-12"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_800"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Calendar View (initially hidden) -->
        <LinearLayout
            android:id="@+id/calendarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="250dp" />

            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Select This Date"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Employee List (initially hidden) -->
    <LinearLayout
        android:id="@+id/employeeListLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/white"
        android:padding="12dp">

        <EditText
            android:id="@+id/etSearchEmployee"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Search by name or mobile..."
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEmployees"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCenterMap"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:backgroundTint="@color/white"
            app:fabSize="mini" />

    </FrameLayout>

    <!-- Stats Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_margin="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Movement Statistics"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_800" />

                <Button
                    android:id="@+id/btnShowRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Show Route"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvStatsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select employee and date to view movement"
                android:textSize="13sp"
                android:textColor="@color/gray_600"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>